# ctest check: cmake -DSRC_DIR=<source dir> -P fortran_pair_wired.cmake
#
# The mocked-call cases prove the function is right; this proves it is CALLED.  A configure that reaches the
# MPI-STRUMPACK branch needs an MPI STRUMPACK install, which cannot be assumed in every build, so the check reads
# CMakeLists.txt (comment lines removed) and requires, inside the `if(AXMP_STRUMPACK_PREFIX)` branch of `if(AXMP_USE_STRUMPACK)`:
#   1. the module is included (before the call);
#   2. exactly one bare call `axmp_check_fortran_pair()` in the whole file;
#   3. the call lies after the find_package(STRUMPACK ... ${AXMP_STRUMPACK_PREFIX} ...) line, before the end of that
#      branch (the `else()` at the branch's own nesting level), and before the branch's first target_link_libraries (the
#      call must precede anything that could link);
# and that docs/install.md carries the install-doc sentence.
cmake_policy(SET CMP0007 NEW)  # keep empty list elements (blank lines)
file(READ "${SRC_DIR}/CMakeLists.txt" _text)
# make the text safe to split into a list at the newlines
string(REPLACE ";" "<semi>" _text "${_text}")
string(REPLACE "[" "<lb>" _text "${_text}")
string(REPLACE "]" "<rb>" _text "${_text}")
string(REPLACE "\n" ";" _raw "${_text}")
set(_lines "")
foreach(l IN LISTS _raw)
  if(NOT l MATCHES "^[ \t]*#")
    list(APPEND _lines "${l}")
  endif()
endforeach()

set(_n 0)
set(_fp -1)
set(_inc -1)
set(_call -1)
set(_ncalls 0)
list(LENGTH _lines _len)
math(EXPR _last "${_len} - 1")
foreach(i RANGE ${_last})
  list(GET _lines ${i} l)
  if(l MATCHES "^[ \t]*axmp_check_fortran_pair\\([ \t]*\\)[ \t]*$")
    math(EXPR _ncalls "${_ncalls} + 1")
  endif()
endforeach()
if(NOT _ncalls EQUAL 1)
  message(FATAL_ERROR "expected exactly one bare call axmp_check_fortran_pair() in CMakeLists.txt, found ${_ncalls}")
endif()

foreach(i RANGE ${_last})
  list(GET _lines ${i} l)
  if(_fp LESS 0 AND l MATCHES "find_package\\([ \t]*STRUMPACK[^)]*AXMP_STRUMPACK_PREFIX[^)]*NO_DEFAULT_PATH")
    set(_fp ${i})
  endif()
endforeach()
if(_fp LESS 0)
  message(FATAL_ERROR "no find_package(STRUMPACK ... AXMP_STRUMPACK_PREFIX ... NO_DEFAULT_PATH) in CMakeLists.txt")
endif()

foreach(i RANGE ${_last})
  list(GET _lines ${i} l)
  if(_inc LESS 0 AND l MATCHES "^[ \t]*include\\([^)]*AxmpFortranCheck")
    set(_inc ${i})
  endif()
endforeach()
if(_inc LESS 0)
  message(FATAL_ERROR "CMakeLists.txt does not include AxmpFortranCheck")
endif()

# walk the rest of the branch
math(EXPR _from "${_fp} + 1")
set(_depth 0)
set(_call -1)
set(_link -1)
set(_end -1)
foreach(i RANGE ${_from} ${_last})
  list(GET _lines ${i} l)
  if(_end GREATER -1)
    break()
  endif()
  if(l MATCHES "^[ \t]*if\\(")
    math(EXPR _depth "${_depth} + 1")
  elseif(l MATCHES "^[ \t]*endif\\(")
    math(EXPR _depth "${_depth} - 1")
    if(_depth LESS 0)
      set(_end ${i})
    endif()
  elseif(l MATCHES "^[ \t]*else(if)?\\(" AND _depth EQUAL 0)
    set(_end ${i})
  endif()
  if(_end LESS 0)
    if(_depth EQUAL 0 AND _call LESS 0 AND l MATCHES "^[ \t]*axmp_check_fortran_pair\\([ \t]*\\)[ \t]*$")
      set(_call ${i})
    endif()
    if(_link LESS 0 AND l MATCHES "^[ \t]*target_link_libraries\\(")
      set(_link ${i})
    endif()
  endif()
endforeach()
if(_call LESS 0)
  message(FATAL_ERROR "axmp_check_fortran_pair() is not called in the AXMP_STRUMPACK_PREFIX branch after its find_package")
endif()
if(_link GREATER -1 AND _call GREATER _link)
  message(FATAL_ERROR "axmp_check_fortran_pair() is called after the branch's first target_link_libraries")
endif()
if(_inc GREATER _call)
  message(FATAL_ERROR "AxmpFortranCheck is included after the call")
endif()

file(READ "${SRC_DIR}/docs/install.md" _doc)
if(NOT _doc MATCHES "of the same GCC as the C\\+\\+ compiler, or newer \\(`-DCMAKE_Fortran_COMPILER=\\.\\.\\.`\\)")
  message(FATAL_ERROR "docs/install.md lacks the sentence 'of the same GCC as the C++ compiler, or newer (`-DCMAKE_Fortran_COMPILER=...`)'")
endif()
message(STATUS "fortran pair check is called after the STRUMPACK find_package; install doc updated")
