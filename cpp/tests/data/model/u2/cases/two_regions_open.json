{
  "name": "two_regions_open",
  "test": "tests/test_fluids_model_bridge.py::test_two_regions_one_fluid_open",
  "description": "(ii) Stokes, Laplacian form, in both regions of split_rect: the parabolic inflow 6 U y (H - y) / H^2 on hot (region a), do_nothing on cold (region b), no-slip on the remaining attributes; plane Poiseuille flow u = 6 U y (H - y) / H^2, p = 12 nu U (L - x) / H^2 is exact in P2/P1; the flux through the section interface is +U H, through hot (outward normal) -U H",
  "build": "mpi",
  "mesh": "the mesher's unstructured mesh of the document (gmsh, bounded planar mode, algorithm and options of axmp-mesher), mesh.size = H/8, region a H/16, geometry order 2 (the default: straight edges, with nodes); one process",
  "instance": null,
  "solver": {
    "solver": "direct",
    "lu": "the build's default (fluids.default_lu())",
    "lu_threads": 1,
    "lu_retry": "auto",
    "direct_tol": 1e-10,
    "form": "laplacian"
  },
  "data": {"nu": 1e-06, "U_mean": 0.01, "L": 0.04, "H": 0.01, "inlet": "hot", "outlet": "cold", "walls": "remaining"},
  "tolerance": {
    "u": {
      "what": "max |u - u_P| / (1.5 U) at the seven sample points (vertices, edge midpoints, centroid) of every element",
      "ceiling": 1e-08,
      "measured": {
        "Intel(R) Xeon(R) Gold 6330 CPU @ 2.00GHz / mpi": 9.593607884311042e-15,
        "AMD EPYC 7401 24-Core Processor / mpi": 1.0301532349485295e-14,
        "AMD EPYC 7452 32-Core Processor / mpi": 1.0301532349485295e-14
      },
      "asserted": 1e-12
    },
    "p": {
      "what": "max |p - p_P| / (12 nu U L / H^2) at the seven sample points (vertices, edge midpoints, centroid) of every element",
      "ceiling": 1e-08,
      "measured": {
        "Intel(R) Xeon(R) Gold 6330 CPU @ 2.00GHz / mpi": 2.392868075993398e-14,
        "AMD EPYC 7401 24-Core Processor / mpi": 2.2869889575866106e-14,
        "AMD EPYC 7452 32-Core Processor / mpi": 2.2869889575866106e-14
      },
      "asserted": 1e-12
    },
    "Q_interface": {
      "what": "|Q(interface) - U H| / (U H) by the instrument",
      "ceiling": 1e-09,
      "measured": {
        "Intel(R) Xeon(R) Gold 6330 CPU @ 2.00GHz / mpi": 5.421010862427522e-16,
        "AMD EPYC 7401 24-Core Processor / mpi": 8.131516293641283e-16,
        "AMD EPYC 7452 32-Core Processor / mpi": 8.131516293641283e-16
      },
      "asserted": 1e-12
    },
    "Q_inlet": {
      "what": "|Q(hot) + U H| / (U H) by the instrument",
      "ceiling": 1e-09,
      "measured": {
        "Intel(R) Xeon(R) Gold 6330 CPU @ 2.00GHz / mpi": 4.0657581468206416e-16,
        "AMD EPYC 7401 24-Core Processor / mpi": 4.0657581468206416e-16,
        "AMD EPYC 7452 32-Core Processor / mpi": 4.0657581468206416e-16
      },
      "asserted": 1e-12
    },
    "Q_interface_plus_inlet": {
      "what": "|Q(interface) + Q(hot)| / (U H)",
      "ceiling": 1e-09,
      "measured": {
        "Intel(R) Xeon(R) Gold 6330 CPU @ 2.00GHz / mpi": 1.3552527156068805e-16,
        "AMD EPYC 7401 24-Core Processor / mpi": 4.0657581468206416e-16,
        "AMD EPYC 7452 32-Core Processor / mpi": 4.0657581468206416e-16
      },
      "asserted": 1e-12
    }
  },
  "recorded": {},
  "unrecorded_platforms": [
    "the lr7 nodes of feature rocky8 (n0150 to n0153), a second processor model of the lr7 partition",
    "any other partition the gate is pointed at"
  ],
  "document": {
    "schema": "axionmultiphysics.design/1",
    "name": "split_rect",
    "description": "a rectangle L x H split at x = L/2 into the regions a and b; a marker across a at x = L/4, written bottom to top; a third region c, disabled; top and bottom left unnamed",
    "symmetry": "planar",
    "parameters": {"L": 0.04, "H": 0.01, "k": 0.6, "cp": 4180.0, "rho": 998.0},
    "materials": {"slab": {"density": "rho", "thermal": {"k_W_mK": "k", "cp_J_kgK": "cp"}}},
    "regions": [
      {"name": "a", "shape": {"rect": {"x": [0, "L/2"], "y": [0, "H"]}}, "material": "slab", "mesh_size": "H/16"},
      {"name": "b", "shape": {"rect": {"x": ["L/2", "L"], "y": [0, "H"]}}, "material": "slab"},
      {"name": "c", "shape": {"rect": {"x": ["L", "1.5*L"], "y": [0, "H"]}}, "material": "slab", "enabled": false}
    ],
    "curves": [{"name": "mk_line", "path": {"segment": [["L/4", 0], ["L/4", "H"]]}}],
    "domains": {"left": ["a"], "slab_all": ["a", "b", "c"]},
    "boundaries": {
      "hot": {"of": "left", "where": {"x": 0}},
      "cold": {"of": "b", "where": {"x": "L"}},
      "interface": {"between": ["left", "b"]},
      "mk": {"curve": "mk_line"}
    },
    "physics": {
      "heat": {
        "type": "heat.transfer",
        "domains": ["slab_all"],
        "boundary_conditions": {
          "hot": {"kind": "temperature", "T_K": 310.0},
          "cold": {"kind": "temperature", "T_K": 290.0},
          "remaining": {"kind": "insulation"}
        }
      }
    },
    "outputs": {"Q_mk": {"kind": "flux", "of": "heat", "on": "mk"}},
    "mesh": {"size": "H/8"}
  }
}
